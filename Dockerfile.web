# The commissioned predecessor is immutable; refresh this pin for each web promotion.
FROM registry.vallery.net/jvallery/weather-web@sha256:d6ddb140bc4e45a73357bfb58f8096972bef8f9ad0f56cafcf7b2486876768a1 AS previous
FROM registry.vallery.net/jvallery/weather-node-base@sha256:89c5244bc22a9bc3287d89ebc7e49b9cb5bb84cd40e6175ac3421d5a9f68b95a AS build
RUN npm install --global pnpm@12.15.0
WORKDIR /app
COPY web/package.json web/pnpm-lock.yaml web/.npmrc ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY web/ ./
COPY scripts/retain-web-assets.mjs /opt/retain-web-assets.mjs
COPY --from=previous /app/build/client /previous-client
# #21: the predecessor is the live web image at promotion time, which carries its own
# .weather-assets.json inventory, so the legacy-baseline exception is gone.
RUN pnpm build \
 && node /opt/retain-web-assets.mjs /app/build/client /previous-client \
 && pnpm prune --prod --ignore-scripts

FROM registry.vallery.net/jvallery/weather-node-base@sha256:af02d57b57719b9657a45199a79264a9437940cd55b3c7b3fc99615654f124a0
ENV NODE_ENV=production PORT=3000 METRICS_PORT=9000
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/build ./build
COPY --from=build /app/package.json /app/server.mjs /app/security-headers.mjs ./
COPY LICENSE THIRD_PARTY_NOTICES.md ./
# The pinned base still ships zlib1g 1:1.3.dfsg+really1.3.1-1+b1 (CVE-2026-85091, HIGH, fixed in +deb13u1).
# Upgrade only that package and fail the build unless the fixed version is installed (#213, AMC D-880).
RUN apt-get update \
 && apt-get install -y --no-install-recommends --only-upgrade zlib1g \
 && rm -rf /var/lib/apt/lists/* \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' zlib1g)" ge '1:1.3.dfsg+really1.3.1-1+deb13u1'
# Runtime base 24.22.3 carries apt 2.6.2; the build stage stays on 24.22.1, the exact engines pin (engine-strict).
# The runtime starts node directly; the base image's bundled npm (undici, brace-expansion) carried fixable Highs (#213).
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
USER 10001:10001
EXPOSE 3000 9000
CMD ["node", "server.mjs"]
