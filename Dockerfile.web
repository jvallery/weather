# The commissioned predecessor is immutable; refresh this pin for each web promotion.
FROM registry.vallery.net/jvallery/weather-web@sha256:975bdd62a4925ac168e800b76dbc4ca1878556e3db31c19046205bd6b3438910 AS previous
FROM registry.vallery.net/jvallery/weather-node-base@sha256:1304d2735b6d11efe11501456ef9e312b1f3141341feec72d61f194c2ab7fd1c AS build
RUN npm install --global pnpm@12.15.0
WORKDIR /app
COPY web/package.json web/pnpm-lock.yaml web/.npmrc ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY web/ ./
COPY scripts/retain-web-assets.mjs /opt/retain-web-assets.mjs
COPY --from=previous /app/build/client /previous-client
# #21: the predecessor is the live web image at promotion time, which carries its own
# .weather-assets.json inventory, so the legacy-baseline exception is gone.
RUN pnpm build \
 && node /opt/retain-web-assets.mjs /app/build/client /previous-client \
 && pnpm prune --prod --ignore-scripts

FROM registry.vallery.net/jvallery/weather-node-base@sha256:1304d2735b6d11efe11501456ef9e312b1f3141341feec72d61f194c2ab7fd1c
ENV NODE_ENV=production PORT=3000 METRICS_PORT=9000
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/build ./build
COPY --from=build /app/package.json /app/server.mjs /app/security-headers.mjs ./
COPY LICENSE THIRD_PARTY_NOTICES.md ./
USER 10001:10001
EXPOSE 3000 9000
CMD ["node", "server.mjs"]
