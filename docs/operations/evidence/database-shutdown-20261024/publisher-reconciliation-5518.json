  "sources": {
    "native_ci_reconcile.py": {
      "sha256": "dd153c2d95f68c1818f1a3289c05377310eda33a4139e15b89060feb4bae6938",
      "start": 285,
      "end": 325,
      "lines": [
        "    # sufficient to publish success for a moving PR.",
        "    head, base = current_refs(plan)",
        "    verdict = journal.verdict(operation_id, current_head=head, current_base=base)",
        "    if verdict[\"state\"] == \"success\" and pending_cleanup:",
        "        verdict = {**verdict, \"state\": \"pending\", \"publish_success\": False,",
        "                   \"pending_cleanup\": pending_cleanup}",
        "    if verdict[\"state\"] == \"success\" and archive_errors:",
        "        # Unreachable while evaluate() requires every archive; kept as an",
        "        # explicit guard so success never publishes over an archive error.",
        "        verdict = {**verdict, \"state\": \"pending\", \"publish_success\": False,",
        "                   \"archive_errors\": sorted(check_id for check_id, _ in archive_errors)}",
        "    verdict = _publish(journal, operation_id, plan, verdict, publish)",
        "    if archive_errors:",
        "        raise archive_errors[0][1]",
        "    return verdict",
        "",
        "",
        "def _publish(journal, operation_id, plan, verdict, publish):",
        "    key = digest({\"plan\": plan[\"plan_sha256\"], \"verdict\": verdict})",
        "    previous = journal.publication(operation_id)",
        "    if previous is None or previous.get(\"key\") != key or previous.get(\"state\") != \"published\":",
        "        prior_receipt = previous.get(\"receipt\") if isinstance(previous, dict) else None",
        "        if (verdict[\"state\"] == \"superseded\" and isinstance(previous, dict)",
        "                and previous.get(\"state\") == \"published\"",
        "                and isinstance(prior_receipt, dict)",
        "                and prior_receipt.get(\"key\") == previous.get(\"key\")",
        "                and prior_receipt.get(\"state\") in (\"success\", \"failure\")",
        "                and prior_receipt.get(\"head_sha\") == plan[\"context\"][\"head_sha\"]",
        "                and prior_receipt.get(\"context\") == \"fleet-ci/native\"):",
        "            # A commit that completed native CI keeps its recorded result after",
        "            # its PR moves or merges. A newer attempt owns the new status.",
        "            journal.record_publication(operation_id, {",
        "                \"key\": key, \"state\": \"published\", \"receipt\": {",
        "                    \"schema\": \"fleet-native-ci-preserved-terminal-status/v1\",",
        "                    \"key\": key, \"state\": \"suppressed\", \"prior\": prior_receipt}})",
        "            return verdict",
        "        journal.record_publication(operation_id, {\"key\": key, \"state\": \"publishing\"})",
        "        receipt = publish(plan, verdict, key)",
        "        if not isinstance(receipt, dict) or receipt.get(\"key\") != key:",
        "            raise NativeCIError(\"publication acknowledgement differs from retained result\")",
        "        journal.record_publication(operation_id, {\"key\": key, \"state\": \"published\", \"receipt\": receipt})"
      ]
    },
    "native_ci_controller.py": {
      "sha256": "7438c9247a5d65bcab5e7051c397538dc7b1d7d5b41ae00031f8379a5a2e530e",
      "start": 650,
      "end": 689,
      "lines": [
        "    # GitHub can receive success. An entirely archived pending run also needs",
        "    # a reconcile visit to compute that verdict. Keep those runs out of the large historical",
        "    # rotation without prioritizing already published completed attempts.",
        "    def awaiting_finalization(operation):",
        "        verdict = journal.db.execute(",
        "            \"SELECT verdict FROM runs WHERE operation_id=?\", (operation,)",
        "        ).fetchone()[0]",
        "        state = json.loads(verdict).get(\"state\") if verdict is not None else None",
        "        if state in (None, \"pending\"):",
        "            # The last archive can settle after this run's reconcile visit.",
        "            # Compute its verdict next cycle instead of demoting an entirely",
        "            # archived current candidate into the historical rotation.",
        "            return (journal.db.execute(",
        "                \"SELECT 1 FROM checks WHERE operation_id=? AND state='archived' LIMIT 1\",",
        "                (operation,),",
        "            ).fetchone() is not None and not journal.db.execute(",
        "                \"SELECT 1 FROM checks WHERE operation_id=? AND state!='archived' LIMIT 1\",",
        "                (operation,),",
        "            ).fetchone())",
        "        if state in (\"success\", \"failure\") and not journal.db.execute(",
        "                \"SELECT 1 FROM checks WHERE operation_id=? AND state NOT IN ('archived','retired') LIMIT 1\",",
        "                (operation,)).fetchone():",
        "            # A status write that failed (left 'publishing') or was keyed to",
        "            # another verdict is retried next cycle, not after a full turn of",
        "            # the historical rotation. Scheduling only: reconcile re-reads refs",
        "            # and recomputes the verdict before any publication.",
        "            publication = journal.publication(operation)",
        "            key = digest({\"plan\": journal.plan(operation)[\"plan_sha256\"], \"verdict\": json.loads(verdict)})",
        "            if (publication is None or publication.get(\"state\") == \"publishing\"",
        "                    or publication.get(\"key\") != key):",
        "                return True",
        "        if state != \"success\":",
        "            return False",
        "        publication = journal.publication(operation)",
        "        return (publication is not None",
        "                and publication.get(\"state\") == \"published\"",
        "                and isinstance(publication.get(\"receipt\"), dict)",
        "                and publication[\"receipt\"].get(\"state\") == \"pending\"",
        "                and not journal.db.execute(",
        "                    \"SELECT 1 FROM checks WHERE operation_id=? AND state!='archived' LIMIT 1\","
      ]
    }
