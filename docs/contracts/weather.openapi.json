          "resolution_seconds": {
            "exclusiveMinimum": 0.0,
            "title": "Resolution Seconds",
            "type": "integer"
          },
          "revision": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
