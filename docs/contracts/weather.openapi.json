          },
          "interval": {
            "$ref": "#/components/schemas/Interval"
          },
          "metric": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Metric",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "statistic": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Statistic",
            "type": "string"
          },
          "unit": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "metric",
          "statistic",
          "value",
          "unit",
          "interval",
          "coverage",
          "evidence_ids",
          "evidence_revision",
          "algorithm_revision",
          "reason"
