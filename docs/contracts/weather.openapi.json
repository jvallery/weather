{
  "components": {
    "schemas": {
      "Aggregate": {
        "additionalProperties": false,
        "properties": {
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "direction_state": {
            "anyOf": [
              {
                "enum": [
                  "directional",
                  "variable",
                  "calm",
                  "missing"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction State"
          },
          "end": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "End",
            "type": "string"
          },
          "evidence_count": {
            "minimum": 0.0,
            "title": "Evidence Count",
            "type": "integer"
          },
          "evidence_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Hash"
          },
          "metric": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Metric",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "rose": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/RoseBin"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rose"
          },
          "start": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "Start",
            "type": "string"
          },
          "statistic": {
            "title": "Statistic",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "metric",
          "statistic",
          "start",
          "end",
          "value",
          "unit",
          "coverage",
          "evidence_count",
          "evidence_hash",
          "reason",
          "direction_state",
          "rose"
        ],
        "title": "Aggregate",
        "type": "object"
      },
      "Aggregates": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "End",
            "type": "string"
          },
          "generated_at": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "Generated At",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Aggregate"
            },
            "title": "Items",
            "type": "array"
          },
          "resolution": {
            "title": "Resolution",
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "generated_at",
          "start",
          "end",
          "resolution",
          "items"
        ],
        "title": "Aggregates",
        "type": "object"
      },
      "Conversion": {
        "additionalProperties": false,
        "description": "display = canonical * scale_numerator / scale_denominator + offset (as a ratio).",
        "properties": {
          "offset_denominator": {
            "exclusiveMinimum": 0.0,
            "title": "Offset Denominator",
            "type": "integer"
          },
          "offset_numerator": {
            "title": "Offset Numerator",
            "type": "integer"
          },
          "scale_denominator": {
            "exclusiveMinimum": 0.0,
            "title": "Scale Denominator",
            "type": "integer"
          },
          "scale_numerator": {
            "title": "Scale Numerator",
            "type": "integer"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "unit",
          "scale_numerator",
          "scale_denominator",
          "offset_numerator",
          "offset_denominator"
        ],
        "title": "Conversion",
        "type": "object"
      },
      "Coverage": {
        "additionalProperties": false,
        "properties": {
          "expected_seconds": {
            "exclusiveMinimum": 0.0,
            "title": "Expected Seconds",
            "type": "number"
          },
          "fraction": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Fraction",
            "type": "number"
          },
          "support_seconds": {
            "minimum": 0.0,
            "title": "Support Seconds",
            "type": "number"
          }
        },
        "required": [
          "fraction",
          "support_seconds",
          "expected_seconds"
        ],
        "title": "Coverage",
        "type": "object"
      },
      "Current": {
        "additionalProperties": false,
        "properties": {
          "data_state": {
            "enum": [
              "live",
              "cached",
              "unavailable"
            ],
            "title": "Data State",
            "type": "string"
          },
          "generated_at": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "Generated At",
            "type": "string"
          },
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/Metric"
            },
            "title": "Metrics",
            "type": "array"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "station_alias": {
            "title": "Station Alias",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "generated_at",
          "station_alias",
          "data_state",
          "metrics"
        ],
        "title": "Current",
        "type": "object"
      },
      "Metric": {
        "additionalProperties": false,
        "properties": {
          "coverage": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverage"
          },
          "expected_interval_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Interval Seconds"
          },
          "freshness": {
            "enum": [
              "fresh",
              "stale",
              "unavailable"
            ],
            "title": "Freshness",
            "type": "string"
          },
          "metric": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Metric",
            "type": "string"
          },
          "observed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          },
          "quality": {
            "enum": [
              "valid",
              "missing",
              "invalid"
            ],
            "title": "Quality",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "received_at": {
            "anyOf": [
              {
                "format": "date-time",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Received At"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "valid_until": {
            "anyOf": [
              {
                "format": "date-time",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid Until"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "metric",
          "value",
          "unit",
          "observed_at",
          "received_at",
          "expected_interval_seconds",
          "valid_until",
          "quality",
          "freshness",
          "reason",
          "coverage"
        ],
        "title": "Metric",
        "type": "object"
      },
      "MetricDefinition": {
        "additionalProperties": false,
        "properties": {
          "canonical_unit": {
            "title": "Canonical Unit",
            "type": "string"
          },
          "conversions": {
            "items": {
              "$ref": "#/components/schemas/Conversion"
            },
            "title": "Conversions",
            "type": "array"
          },
          "expected_interval_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Interval Seconds"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "metric": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Metric",
            "type": "string"
          },
          "statistics": {
            "items": {
              "type": "string"
            },
            "title": "Statistics",
            "type": "array"
          }
        },
        "required": [
          "metric",
          "label",
          "canonical_unit",
          "conversions",
          "statistics",
          "expected_interval_seconds"
        ],
        "title": "MetricDefinition",
        "type": "object"
      },
      "MetricRegistry": {
        "additionalProperties": false,
        "properties": {
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/MetricDefinition"
            },
            "title": "Metrics",
            "type": "array"
          }
        },
        "required": [
          "metrics"
        ],
        "title": "MetricRegistry",
        "type": "object"
      },
      "ObservationPoint": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "metric": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Metric",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "Observed At",
            "type": "string"
          },
          "quality": {
            "enum": [
              "valid",
              "missing",
              "invalid"
            ],
            "title": "Quality",
            "type": "string"
          },
          "received_at": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "Received At",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "id",
          "observed_at",
          "received_at",
          "metric",
          "value",
          "unit",
          "quality"
        ],
        "title": "ObservationPoint",
        "type": "object"
      },
      "Observations": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "End",
            "type": "string"
          },
          "generated_at": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "Generated At",
            "type": "string"
          },
          "metrics": {
            "items": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "title": "Metrics",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/ObservationPoint"
            },
            "maxItems": 5000,
            "title": "Points",
            "type": "array"
          },
          "start": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "generated_at",
          "start",
          "end",
          "metrics",
          "points",
          "next_cursor"
        ],
        "title": "Observations",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "suggested_resolution_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Resolution Seconds"
          }
        },
        "required": [
          "code",
          "message",
          "suggested_resolution_seconds"
        ],
        "title": "Problem",
        "type": "object"
      },
      "RoseBin": {
        "additionalProperties": false,
        "description": "Duration in one category; directional sectors are half-open, from-direction degrees.",
        "properties": {
          "category": {
            "enum": [
              "directional",
              "calm",
              "variable",
              "missing"
            ],
            "title": "Category",
            "type": "string"
          },
          "duration_seconds": {
            "minimum": 0.0,
            "title": "Duration Seconds",
            "type": "number"
          },
          "sector_end": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sector End"
          },
          "sector_start": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sector Start"
          },
          "speed_max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed Max"
          },
          "speed_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed Min"
          }
        },
        "required": [
          "category",
          "sector_start",
          "sector_end",
          "speed_min",
          "speed_max",
          "duration_seconds"
        ],
        "title": "RoseBin",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Weather public API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/weather/aggregates": {
      "get": {
        "operationId": "getAggregates",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "required": true,
            "schema": {
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
              "title": "Start",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": true,
            "schema": {
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
              "title": "End",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "metrics",
            "required": true,
            "schema": {
              "items": {
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              },
              "maxItems": 8,
              "minItems": 1,
              "title": "Metrics",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "statistics",
            "required": true,
            "schema": {
              "items": {
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              },
              "maxItems": 4,
              "minItems": 1,
              "title": "Statistics",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "resolution",
            "required": true,
            "schema": {
              "pattern": "^(day|[1-9][0-9]{1,7})$",
              "title": "Resolution",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Aggregates"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid request."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Weather data is temporarily unavailable."
          }
        },
        "summary": "Get Aggregates"
      }
    },
    "/api/v1/weather/current": {
      "get": {
        "operationId": "getCurrent",
        "parameters": [
          {
            "in": "header",
            "name": "if-none-match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 1024,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Current"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Unchanged since the given ETag."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid request."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Weather data is temporarily unavailable."
          }
        },
        "summary": "Get Current"
      }
    },
    "/api/v1/weather/metrics": {
      "get": {
        "operationId": "getMetrics",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricRegistry"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Metrics"
      }
    },
    "/api/v1/weather/observations": {
      "get": {
        "operationId": "getObservations",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "required": true,
            "schema": {
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
              "title": "Start",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": true,
            "schema": {
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
              "title": "End",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "metrics",
            "required": true,
            "schema": {
              "items": {
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              },
              "maxItems": 16,
              "minItems": 1,
              "title": "Metrics",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 1000,
              "maximum": 5000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9_.-]{1,2048}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Observations"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid request."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Weather data is temporarily unavailable."
          }
        },
        "summary": "Get Observations"
      }
