            "title": "Resultant"
          },
          "rose": {
            "items": {
              "$ref": "#/components/schemas/WindRoseBin"
            },
            "maxItems": 83,
            "minItems": 1,
            "title": "Rose",
            "type": "array"
          },
          "speed_coverage": {
            "$ref": "#/components/schemas/Coverage"
          }
        },
        "required": [
          "mean_speed",
          "maximum_gust",
          "direction_degrees",
          "direction_state",
          "resultant",
          "speed_coverage",
          "direction_coverage",
          "rose",
          "algorithm_revision",
          "evidence_revision",
          "evidence_ids",
          "aggregate_id"
        ],
        "title": "Wind",
        "type": "object"
      },
      "WindRoseBin": {
        "additionalProperties": false,
        "description": "Angles are meteorological-from degrees; speed bounds are canonical m/s.",
        "properties": {
          "angle_end": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  }
                ],
                "ge": 0,
                "lt": 360
              },
              {
                "type": "null"
              }
            ],
            "title": "Angle End"
          },
          "angle_start": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  }
                ],
                "ge": 0,
                "lt": 360
              },
              {
                "type": "null"
              }
            ],
            "title": "Angle Start"
          },
          "category": {
            "enum": [
              "directional",
              "calm",
              "variable",
              "missing"
            ],
            "title": "Category",
            "type": "string"
          },
          "denominator_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "gt": 0,
            "title": "Denominator Seconds"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "ge": 0,
            "title": "Duration Seconds"
          },
          "speed_max": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  }
                ],
                "gt": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed Max"
          },
          "speed_min": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  }
                ],
                "ge": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed Min"
          }
        },
        "required": [
          "category",
          "angle_start",
          "angle_end",
          "speed_min",
          "speed_max",
          "duration_seconds",
          "denominator_seconds"
        ],
        "title": "WindRoseBin",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Weather public API",
    "version": "1"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/v1/weather/aggregates": {
      "get": {
        "operationId": "getAggregates",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "required": true,
            "schema": {
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
              "title": "Start",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": true,
            "schema": {
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
              "title": "End",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "metrics",
            "required": true,
            "schema": {
              "items": {
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              },
              "maxItems": 32,
              "minItems": 1,
              "title": "Metrics",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 1000,
              "maximum": 5000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9_.-]{1,2048}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "resolution_seconds",
            "required": true,
            "schema": {
              "exclusiveMinimum": 0,
              "maximum": 2147483647,
              "title": "Resolution Seconds",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "statistic",
            "required": true,
            "schema": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "title": "Statistic",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Aggregates"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid bounded public request."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Public data is unavailable."
          }
        },
        "summary": "Aggregates"
      }
    },
    "/api/v1/weather/current": {
      "get": {
        "operationId": "getCurrent",
        "parameters": [
          {
            "in": "header",
            "name": "If-None-Match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 4096,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Current"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "description": "At most five seconds, bounded by remaining freshness.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Weak validator of values, source timing, quality and data state.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Unchanged semantic current representation.",
            "headers": {
              "Cache-Control": {
                "description": "At most five seconds, bounded by remaining freshness.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Weak validator of values, source timing, quality and data state.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid bounded public request."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Public data is unavailable."
          }
        },
        "summary": "Current"
      }
    },
    "/api/v1/weather/metrics": {
      "get": {
        "operationId": "getMetricRegistry",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricRegistry"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Metric Registry"
      }
    },
    "/api/v1/weather/observations": {
      "get": {
        "operationId": "getObservations",
        "parameters": [
          {
