{
  "contract_version": 2,
  "kind": "declarative_acceptance_vectors_not_test_results",
  "decision": "../decisions/D05-telemetry-integrity.md",
  "identity_policy": "All station and receiver identifiers in these fixtures are synthetic.",
  "vectors": [
    {
      "id": "T01",
      "case": "one datagram delivered twice",
      "input": {
        "packet": {
          "serial_number": "SYNTHETIC-ST",
          "type": "rapid_wind",
          "hub_sn": "SYNTHETIC-HUB",
          "ob": [
            1700000000,
            2.3,
            128
          ]
        },
        "deliveries": 2
      },
      "expect": {
        "raw_receipts": 2,
        "canonical_observations": 1,
        "provenance_links": 2
      }
    },
    {
      "id": "T02",
      "case": "uncertain database acknowledgement",
      "input": {
        "receipt_id": "00000000-0000-4000-8000-000000000002",
        "attempts": 3,
        "identical_bytes_and_metadata": true
      },
      "expect": {
        "raw_receipts": 1,
        "projection_work_items_for_parser_version": 1,
        "spool_deleted_only_after_database_commit_returns": true
      }
    },
    {
      "id": "T03",
      "case": "receipt identity collision",
      "input": {
        "same_receipt_id": true,
        "different_payloads": true
      },
      "expect": {
        "overwrite_allowed": false,
        "integrity_incident": true,
        "both_payloads_retained_as_evidence": true
      }
    },
    {
      "id": "T04",
      "case": "all rows with invalid sibling",
      "input": {
        "packet": {
          "serial_number": "SYNTHETIC-ST",
          "type": "obs_st",
          "obs": [
            [
              1700000000,
              0.1,
              0.2,
              0.3,
              90,
              3,
              1000,
              20,
              50,
              100,
              1,
              50,
              0,
              0,
              0,
              0,
              2.5,
              1
            ],
            [],
            [
              1700000060,
              0.1,
              0.2,
              0.3,
              90,
              3,
              1000,
              21,
              50,
              100,
              1,
              50,
              0,
              0,
              0,
              0,
              2.5,
              1
            ]
          ],
          "future_field": {
            "retained": true
          },
          "hub_sn": "SYNTHETIC-HUB"
        }
      },
      "expect": {
        "row_projections": 3,
        "valid_observation_rows": 2,
        "quarantined_rows": 1,
        "unknown_fields_retained": true
      }
    },
    {
      "id": "T05",
      "case": "duplicate JSON keys",
      "input": {
        "utf8": "{\"type\":\"rapid_wind\",\"type\":\"obs_st\"}"
      },
      "expect": {
        "exact_raw_retained": true,
        "normalization_quarantined": true
      }
    },
    {
      "id": "T06",
      "case": "malformed UTF-8",
      "input": {
        "bytes_hex": "fffe00"
      },
      "expect": {
        "exact_raw_retained": true,
        "canonical_observations": 0,
        "parse_error_recorded": true
      }
    },
    {
      "id": "T07",
      "case": "unknown future family",
      "input": {
        "packet": {
          "type": "synthetic_future_family",
          "values": [
            1,
            null,
            3
          ]
        }
      },
      "expect": {
        "exact_raw_retained": true,
        "parsed_unknown_record_queryable": true,
        "canonical_observations": 0
      }
    },
    {
      "id": "T08",
      "case": "same timestamp conflicting temperature",
      "input": {
        "source_timestamp": 1700000000,
        "temperature_variants_c": [
          20,
          23
        ],
        "matching_humidity_percent": 50
      },
      "expect": {
        "temperature_qualified": false,
        "humidity_may_remain_qualified": true,
        "last_arrival_wins": false
      }
    },
    {
      "id": "T09",
      "case": "ambiguous identical lightning events",
      "input": {
        "authoritative_interval_count": 2,
        "evt_strike_deliveries": [
          [
            1700000000,
            10,
            100
          ],
          [
            1700000000,
            10,
            100
          ],
          [
            1700000000,
            10,
            100
          ]
        ]
      },
      "expect": {
        "raw_event_receipts": 3,
        "measured_strike_count": 2,
        "event_multiplicity": "ambiguous",
        "add_events_to_interval_count": false
      }
    },
    {
      "id": "T10",
      "case": "event packets without interval authority",
      "input": {
        "evt_strike": [
          1700000000,
          10,
          100
        ],
        "interval_count": null
      },
      "expect": {
        "reported_strike_annotation": true,
        "measured_count_available": false
      }
    },
    {
      "id": "T11",
      "case": "replay does not freshen",
      "input": {
        "source_epoch": 1700000000,
        "first_receive_epoch": 1700000001,
        "replay_epoch": 1700086400,
        "freshness_seconds": 15
      },
      "expect": {
        "fresh_at_replay": false,
        "expiry_epoch": 1700000015
      }
    },
    {
      "id": "T12",
      "case": "support union",
      "input": {
        "window_seconds": [
          0,
          60
        ],
        "valid_support_seconds": [
          [
            0,
            30
          ],
          [
            20,
            40
          ]
        ]
      },
      "expect": {
        "covered_seconds": 40,
        "coverage_fraction": "2/3"
      }
    },
    {
      "id": "T13",
      "case": "conserved precipitation split",
      "input": {
        "qualified_support_seconds": [
          0,
          60
        ],
        "amount_mm": 2,
        "windows_seconds": [
          [
            0,
            15
          ],
          [
            15,
            60
          ]
        ]
      },
      "expect": {
        "allocated_mm": [
          0.5,
          1.5
        ],
        "total_mm": 2,
        "estimate_label": "uniform intensity over support"
      }
    },
    {
      "id": "T14",
      "case": "report interval does not redefine rain support",
      "input": {
        "source_epoch": 1700000000,
        "report_interval_minutes": 5,
        "rain_previous_minute_mm": 1
      },
      "expect": {
        "inferred_rain_support_seconds": 60,
        "inferred_rain_support_from_report_interval": false,
        "firmware_support_requires_qualification": true
      }
    },
    {
      "id": "T15",
      "case": "boundary lightning count",
      "input": {
        "support_seconds": [
          0,
          60
        ],
        "count": 3,
        "windows_seconds": [
          [
            0,
            30
          ],
          [
            30,
            60
          ]
        ]
      },
      "expect": {
        "boundary_uncertain_count": 3,
        "fractional_counts_allowed": false,
        "qualified_count_in_either_window": 0,
        "zero_is_complete_total": false
      }
    },
    {
      "id": "T16",
      "case": "SQLite FULL commit and uncertain database acknowledgement boundaries",
      "input": {
        "committed_receipts": [
          {
            "synthetic_id": "00000000-0000-4000-8000-000000000161",
            "db_committed": true,
            "local_delete_committed": false
          },
          {
            "synthetic_id": "00000000-0000-4000-8000-000000000162",
            "db_committed": false
          }
        ],
        "uncommitted_sqlite_insert": true,
        "unreadable_generation": "retained intact separately"
      },
      "expect": {
        "replay_committed_receipt_ids": [
          "00000000-0000-4000-8000-000000000161",
          "00000000-0000-4000-8000-000000000162"
        ],
        "first_database_commit_idempotent": true,
        "uncommitted_insert_visible": false,
        "invent_tail_bytes_or_sequence": false,
        "unreadable_generation_quarantined_intact": true,
        "unknown_volatile_loss_reported": true
      }
    },
    {
      "id": "T17",
      "case": "spool capacity exhaustion",
      "input": {
        "usable_data_capacity_reached": true,
        "new_receipts": 5,
        "diagnostic_storage_healthy": true
      },
      "expect": {
        "old_unacknowledged_receipts_overwritten": false,
        "capacity_drop_count": 5,
        "collection_health": "degraded"
      }
    },
    {
      "id": "T18",
      "case": "source clock reset and late pre-reset row",
      "input": {
        "arrival_source_epochs": [
          1700000000,
          1699999900,
          1700000000
        ],
        "status_reset_between_first_two": true
      },
      "expect": {
        "new_epoch_inferred_from_arrival_order": false,
        "same_timestamp_variants_reconciled": true,
        "older_row_replaces_current": false
      }
    },
    {
      "id": "T19",
      "case": "late correction invalidates dependents",
      "input": {
        "aggregate_revision": 7,
        "late_observation_changes_evidence": true,
        "inference_available": false
      },
      "expect": {
        "new_aggregate_revision": 8,
        "outbox_recompute_enqueued": true,
        "stale_synthesis_invalidated": true,
        "measurements_available": true
      }
    },
    {
      "id": "T20",
      "case": "same values with later source time",
      "input": {
        "samples": [
          [
            1700000000,
            2.3,
            128
          ],
          [
            1700000003,
            2.3,
            128
          ]
        ]
      },
      "expect": {
        "canonical_observations": 2,
        "value_only_deduplication": false
      }
    }
  ]
}
