{
  "contract_version": 3,
  "kind": "telemetry_acceptance_vectors",
  "decision": "../decisions/2026-10-24-takeover-replan.md",
  "identity_policy": "All station and receiver identifiers in these fixtures are synthetic.",
  "suites": {
    "unit": "app/tests/telemetry/test_vectors.py (parser, admission, spool)",
    "integration": "app/tests/telemetry/test_ingest_integration.py (PostgreSQL, fleet CI only)",
    "aggregate": "read-side aggregation semantics owned by #14"
  },
  "vectors": [
    {
      "id": "T01",
      "case": "one datagram delivered twice",
      "suite": "integration",
      "input": {
        "packet": {
          "serial_number": "SYNTHETIC-ST",
          "type": "rapid_wind",
          "hub_sn": "SYNTHETIC-HUB",
          "ob": [
            1700000000,
            2.3,
            128
          ]
        },
        "deliveries": 2
      },
      "expect": {
        "raw_receipts": 2,
        "canonical_observations": 1
      }
    },
    {
      "id": "T02",
      "case": "uncertain database acknowledgement",
      "suite": "integration",
      "input": {
        "receipt_id": "00000000-0000-4000-8000-000000000002",
        "attempts": 3,
        "packet": {
          "serial_number": "SYNTHETIC-ST",
          "type": "rapid_wind",
          "hub_sn": "SYNTHETIC-HUB",
          "ob": [
            1700000000,
            2.3,
            128
          ]
        }
      },
      "expect": {
        "raw_receipts": 1,
        "canonical_observations": 1,
        "spool_deleted_only_after_database_commit_returns": true
      }
    },
    {
      "id": "T04",
      "case": "all rows with invalid sibling",
      "suite": "unit",
      "input": {
        "packet": {
          "serial_number": "SYNTHETIC-ST",
          "type": "obs_st",
          "obs": [
            [
              1700000000,
              0.1,
              0.2,
              0.3,
              90,
              3,
              1000,
              20,
              50,
              100,
              1,
              50,
              0,
              0,
              0,
              0,
              2.5,
              1
            ],
            [],
            [
              1700000060,
              0.1,
              0.2,
              0.3,
              90,
              3,
              1000,
              21,
              50,
              100,
              1,
              50,
              0,
              0,
              0,
              0,
              2.5,
              1
            ]
          ],
          "future_field": {
            "retained": true
          },
          "hub_sn": "SYNTHETIC-HUB"
        }
      },
      "expect": {
        "rows": 3,
        "valid_rows": 2,
        "quarantined_rows": 1
      }
    },
    {
      "id": "T05",
      "case": "duplicate JSON keys",
      "suite": "unit",
      "input": {
        "utf8": "{\"type\":\"rapid_wind\",\"type\":\"obs_st\"}"
      },
      "expect": {
        "parse_state": "quarantined",
        "reason": "duplicate_json_key",
        "admitted": false
      }
    },
    {
      "id": "T06",
      "case": "malformed UTF-8",
      "suite": "unit",
      "input": {
        "bytes_hex": "fffe00"
      },
      "expect": {
        "parse_state": "quarantined",
        "reason": "malformed_utf8",
        "admitted": false
      }
    },
    {
      "id": "T07",
      "case": "unknown future family",
      "suite": "unit",
      "input": {
        "packet": {
          "serial_number": "SYNTHETIC-HUB",
          "type": "synthetic_future_family",
          "values": [
            1,
            null,
            3
          ]
        }
      },
      "expect": {
        "parse_state": "unsupported",
        "rows": 0,
        "admitted": true
      }
    },
    {
      "id": "T10",
      "case": "event packets without interval authority",
      "suite": "aggregate",
      "input": {
        "evt_strike": [
          1700000000,
          10,
          100
        ],
        "interval_count": null
      },
      "expect": {
        "reported_strike_annotation": true,
        "measured_count_available": false
      }
    },
    {
      "id": "T11",
      "case": "replay does not freshen",
      "suite": "aggregate",
      "input": {
        "source_epoch": 1700000000,
        "first_receive_epoch": 1700000001,
        "replay_epoch": 1700086400,
        "freshness_seconds": 15
      },
      "expect": {
        "fresh_at_replay": false,
        "expiry_epoch": 1700000015
      }
    },
    {
      "id": "T12",
      "case": "support union",
      "suite": "aggregate",
      "input": {
        "window_seconds": [
          0,
          60
        ],
        "valid_support_seconds": [
          [
            0,
            30
          ],
          [
            20,
            40
          ]
        ]
      },
      "expect": {
        "covered_seconds": 40,
        "coverage_fraction": "2/3"
      }
    },
    {
      "id": "T13",
      "case": "conserved precipitation split",
      "suite": "aggregate",
      "input": {
        "qualified_support_seconds": [
          0,
          60
        ],
        "amount_mm": 2,
        "windows_seconds": [
          [
            0,
            15
          ],
          [
            15,
            60
          ]
        ]
      },
      "expect": {
        "allocated_mm": [
          0.5,
          1.5
        ],
        "total_mm": 2,
        "estimate_label": "uniform intensity over support"
      }
    },
    {
      "id": "T14",
      "case": "rain support is the minute ending at source time, independent of report interval",
      "suite": "unit",
      "input": {
        "packet": {
          "serial_number": "SYNTHETIC-ST",
          "hub_sn": "SYNTHETIC-HUB",
          "type": "obs_st",
          "obs": [
            [
              1700000000,
              0.1,
              0.2,
              0.3,
              90,
              3,
              1000,
              20,
              50,
              100,
              1,
              50,
              1,
              1,
              0,
              0,
              2.5,
              5
            ]
          ]
        }
      },
      "expect": {
        "rain_mm": 1,
        "rain_support_epochs": [
          1699999940,
          1700000000
        ],
        "wind_avg_support_epochs": [
          1699999700,
          1700000000
        ]
      }
    },
    {
      "id": "T15",
      "case": "boundary lightning count",
      "suite": "aggregate",
      "input": {
        "support_seconds": [
          0,
          60
        ],
        "count": 3,
        "windows_seconds": [
          [
            0,
            30
          ],
          [
            30,
            60
          ]
        ]
      },
      "expect": {
        "boundary_uncertain_count": 3,
        "fractional_counts_allowed": false,
        "qualified_count_in_either_window": 0,
        "zero_is_complete_total": false
      }
    },
    {
      "id": "T16",
      "case": "SQLite FULL commit and uncertain database acknowledgement boundaries",
      "suite": "unit",
      "input": {
        "committed_receipts": 2,
        "uncommitted_sqlite_insert": true,
        "unreadable_generation": true
      },
      "expect": {
        "replayed_receipts": 2,
        "uncommitted_insert_visible": false,
        "unreadable_generation_quarantined_intact": true
      }
    },
    {
      "id": "T17",
      "case": "spool capacity exhaustion",
      "suite": "unit",
      "input": {
        "usable_data_capacity_reached": true,
        "new_receipts": 5
      },
      "expect": {
        "old_unacknowledged_receipts_overwritten": false,
        "capacity_drop_count": 5,
        "pressure": "warning"
      }
    },
    {
      "id": "T18",
      "case": "source clock reset and late pre-reset row",
      "suite": "integration",
      "input": {
        "arrival_source_epochs": [
          1700000000,
          1699999900,
          1700000000
        ]
      },
      "expect": {
        "canonical_source_epochs": [
          1699999900,
          1700000000
        ],
        "first_row_kept": true
      }
    },
    {
      "id": "T20",
      "case": "same values with later source time",
      "suite": "integration",
      "input": {
        "samples": [
          [
            1700000000,
            2.3,
            128
          ],
          [
            1700000003,
            2.3,
            128
          ]
        ]
      },
      "expect": {
        "canonical_observations": 2
      }
    }
  ]
}
