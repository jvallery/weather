        "title": "Subject",
        "type": "object"
      },
      "SubjectPatch": {
        "additionalProperties": false,
        "properties": {
          "changes": {
            "$ref": "#/components/schemas/Changes"
          },
          "expected_revision": {
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "reason": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "expected_revision",
          "reason",
          "changes"
        ],
        "title": "SubjectPatch",
        "type": "object"
      },
      "Tag": {
        "additionalProperties": false,
        "properties": {
          "tag": {
            "pattern": "^[a-z0-9][a-z0-9 _-]{0,47}$",
            "title": "Tag",
            "type": "string"
          },
          "visibility": {
            "enum": [
              "public",
              "private"
            ],
            "title": "Visibility",
            "type": "string"
          }
        },
        "required": [
          "tag",
          "visibility"
        ],
        "title": "Tag",
        "type": "object"
      },
      "VideoSummary": {
        "additionalProperties": false,
        "properties": {
          "camera": {
            "title": "Camera",
            "type": "string"
          },
          "cycle_date": {
            "format": "date",
            "title": "Cycle Date",
            "type": "string"
          },
          "end": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "End",
            "type": "string"
          },
          "segment": {
            "enum": [
              "daytime",
              "overnight"
            ],
            "title": "Segment",
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "Start",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "withdrawn": {
            "title": "Withdrawn",
            "type": "boolean"
          }
        },
        "required": [
          "camera",
          "cycle_date",
          "segment",
          "start",
          "end",
          "state",
          "withdrawn"
        ],
        "title": "VideoSummary",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Weather operator API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/operator/events": {
      "post": {
        "operationId": "createManualEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subject"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "Invalid query."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "No authenticated identity."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "Not an allowlisted operator, or a cross-origin mutation."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "No such subject."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "Revision conflict or rebase required."
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "The body must be JSON."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "Invalid change."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "The editor is temporarily unavailable."
          }
        },
        "summary": "Manual Event"
      }
    },
    "/api/v1/operator/session": {
      "get": {
        "operationId": "getOperator",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operator"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "Invalid query."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "No authenticated identity."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "Not an allowlisted operator, or a cross-origin mutation."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "No such subject."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "The editor is temporarily unavailable."
          }
        },
        "summary": "Session"
      }
    },
    "/api/v1/operator/subjects/{subject_id}": {
      "get": {
        "operationId": "getSubject",
        "parameters": [
          {
            "in": "path",
            "name": "subject_id",
            "required": true,
            "schema": {
              "title": "Subject Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subject"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "Invalid query."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "No authenticated identity."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorProblem"
                }
              }
            },
            "description": "Not an allowlisted operator, or a cross-origin mutation."
          },
          "404": {
            "content": {
