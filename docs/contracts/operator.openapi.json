{
  "components": {
    "schemas": {
      "AuditEntry": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "edit",
              "rebase",
              "manual_event"
            ],
            "title": "Action",
            "type": "string"
          },
          "actor": {
            "title": "Actor",
            "type": "string"
          },
          "new_revision": {
            "title": "New Revision",
            "type": "integer"
          },
          "old_revision": {
            "title": "Old Revision",
            "type": "integer"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "recorded_at": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "Recorded At",
            "type": "string"
          }
        },
        "required": [
          "action",
          "actor",
          "recorded_at",
          "reason",
          "old_revision",
          "new_revision"
        ],
        "title": "AuditEntry",
        "type": "object"
      },
      "Changes": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 8000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "event": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EventChange"
              },
              {
                "type": "null"
              }
            ]
          },
          "favorite": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Favorite"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "rebase": {
            "anyOf": [
              {
                "const": true,
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rebase"
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/Tag"
            },
            "maxItems": 32,
            "title": "Tags",
            "type": "array"
          }
        },
        "title": "Changes",
        "type": "object"
      },
      "DescriptionState": {
        "additionalProperties": false,
        "description": "Old versus new evidence: what the human text was written against, and what is current.",
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "automated": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Automated"
          },
          "bound": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Evidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "current": {
            "$ref": "#/components/schemas/Evidence"
          },
          "effective": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective"
          },
          "human": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Human"
          },
          "stale": {
            "title": "Stale",
            "type": "boolean"
          }
        },
        "required": [
          "human",
          "active",
          "stale",
          "effective",
          "automated",
          "bound",
          "current"
        ],
        "title": "DescriptionState",
        "type": "object"
      },
      "EventChange": {
        "additionalProperties": false,
        "description": "An event correction through #41's override hook: label or visibility only.",
        "properties": {
          "label": {
            "anyOf": [
              {
                "maxLength": 240,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "visibility": {
            "anyOf": [
              {
                "enum": [
                  "public",
                  "private",
                  "withdrawn"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Visibility"
          }
        },
        "title": "EventChange",
        "type": "object"
      },
      "EventRevision": {
        "additionalProperties": false,
        "properties": {
          "author_kind": {
            "title": "Author Kind",
            "type": "string"
          },
          "evidence_hash": {
            "title": "Evidence Hash",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "visibility": {
            "enum": [
              "public",
              "private",
              "withdrawn"
            ],
            "title": "Visibility",
            "type": "string"
          },
          "withdrawal_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Withdrawal Reason"
