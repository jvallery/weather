          "end": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "End",
            "type": "string"
          },
          "human": {
            "anyOf": [
