          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "origin": {
            "title": "Origin",
            "type": "string"
          },
          "stale": {
            "title": "Stale",
            "type": "boolean"
          },
          "start": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "origin",
          "basis",
          "camera",
          "start",
          "end",
          "current",
          "human",
          "stale"
        ],
        "title": "EventState",
        "type": "object"
      },
      "Evidence": {
        "additionalProperties": false,
        "properties": {
          "evidence_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Hash"
          },
          "media_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Media Sha256"
          }
        },
        "required": [
          "media_sha256",
          "evidence_hash"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "ManualEvent": {
        "additionalProperties": false,
        "description": "A standalone manual annotation through #41's write_manual hook.",
        "properties": {
          "basis": {
            "enum": [
              "instrument",
              "visual",
              "inference"
            ],
            "title": "Basis",
            "type": "string"
          },
          "camera": {
            "anyOf": [
              {
                "enum": [
                  "skycam_east",
                  "skycam_west",
                  "frontyard_1"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Camera"
          },
          "end": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "End",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 256,
            "title": "Evidence Ids",
            "type": "array"
          },
          "label": {
            "maxLength": 240,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "reason": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "label",
          "basis",
          "start",
          "end"
        ],
        "title": "ManualEvent",
        "type": "object"
      },
      "Operator": {
        "additionalProperties": false,
        "properties": {
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "title": "Operator",
        "type": "object"
      },
      "OperatorProblem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "current_revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Revision"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "current_revision"
        ],
        "title": "OperatorProblem",
        "type": "object"
      },
      "Receipt": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "bytes_base64": {
            "title": "Bytes Base64",
            "type": "string"
          },
          "family": {
            "title": "Family",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "parse_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parse Reason"
          },
          "parse_state": {
            "enum": [
              "parsed",
              "unsupported",
              "quarantined"
            ],
            "title": "Parse State",
            "type": "string"
          },
          "parser_revision": {
            "title": "Parser Revision",
            "type": "string"
          },
          "received_at": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "Received At",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "id",
          "received_at",
          "family",
          "parse_state",
          "parse_reason",
          "parser_revision",
          "sha256",
          "bytes",
          "bytes_base64"
        ],
        "title": "Receipt",
        "type": "object"
      },
      "Receipts": {
        "additionalProperties": false,
        "properties": {
          "generated_at": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
            "title": "Generated At",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Receipt"
            },
            "maxItems": 100,
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "generated_at",
          "items",
          "next_cursor"
        ],
        "title": "Receipts",
        "type": "object"
      },
      "Subject": {
        "additionalProperties": false,
        "properties": {
          "audit": {
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            },
            "maxItems": 20,
            "title": "Audit",
            "type": "array"
          },
          "description": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DescriptionState"
              },
              {
                "type": "null"
              }
            ]
          },
          "event": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EventState"
              },
              {
                "type": "null"
              }
            ]
          },
          "favorite": {
            "title": "Favorite",
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "video",
              "event"
            ],
            "title": "Kind",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "subject_id": {
            "format": "uuid",
            "title": "Subject Id",
            "type": "string"
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/Tag"
            },
            "title": "Tags",
            "type": "array"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "video": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VideoSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "subject_id",
          "kind",
          "revision",
          "updated_at",
          "video",
          "description",
          "event",
          "tags",
          "favorite",
          "note",
          "audit"
