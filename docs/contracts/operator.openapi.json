        },
        "required": [
          "revision",
          "label",
          "visibility",
          "withdrawal_reason",
          "author_kind",
          "evidence_hash"
        ],
        "title": "EventRevision",
        "type": "object"
      },
      "EventState": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "title": "Basis",
            "type": "string"
          },
          "camera": {
            "anyOf": [
