{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weather.vallery.net/contracts/hourly-archive-v1.schema.json",
  "title": "Private committed native hourly original and calendar FK receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "hourly_original_archive_commit"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "work_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "work_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expected_selection_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "selection_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "camera": {
      "enum": [
        "skycam_east",
        "skycam_west",
        "frontyard_1"
      ]
    },
    "calendar_date": {
      "type": "string",
      "format": "date"
    },
    "day_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "slot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "slot_interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "slot_local_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "capture_attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,88}$"
    },
    "source_interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "source_selection_offset_seconds": {
      "type": "number"
    },
    "selection_policy_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "source_custody": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "sealed_capture_chunk",
            "compact_promotion"
          ]
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "pin_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "record_id",
        "pin_id",
        "bytes",
        "sha256"
      ]
    },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "object_locator_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "asset_class": {
          "const": "hourly_original"
        },
        "visibility": {
          "const": "private"
        },
        "mime": {
          "const": "image/jpeg"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_verification_receipt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "local_durability_receipt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        }
      },
      "required": [
        "asset_id",
        "object_locator_id",
        "asset_class",
        "visibility",
        "mime",
        "bytes",
        "sha256",
        "width",
        "height",
        "content_verification_receipt_id",
        "local_durability_receipt_id"
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "original_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "publication_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "database_commit_receipt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "fk_validation_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "retention_policy_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "retention_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recovery_policy_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "recovery_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retention_anchor": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "original_revision",
        "publication_generation",
        "database_commit_receipt_id",
        "fk_validation_revision",
        "retention_policy_id",
        "retention_policy_sha256",
        "recovery_policy_id",
        "recovery_policy_sha256",
        "retention_anchor"
      ]
    },
    "committed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "receipt_id",
    "idempotency_key",
    "work_id",
    "work_generation",
    "expected_selection_revision",
    "selection_sha256",
    "camera",
    "calendar_date",
    "day_id",
    "slot_id",
    "slot_interval",
    "slot_local_label",
    "capture_attempt_id",
    "source_interval",
    "source_selection_offset_seconds",
    "selection_policy_revision",
    "source_custody",
    "original",
    "catalog",
    "committed_at"
  ]
}
