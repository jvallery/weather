{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weather.vallery.net/contracts/promotion-v1.schema.json",
  "title": "Private durable compact transfer commit; shape is not custody authority",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "compact_transfer_commit"
    },
    "transfer_id": {
      "$ref": "#/$defs/Id"
    },
    "idempotency_key": {
      "$ref": "#/$defs/Id"
    },
    "kind": {
      "enum": [
        "hourly_original",
        "keogram_inputs"
      ]
    },
    "camera": {
      "enum": [
        "skycam_east",
        "skycam_west",
        "frontyard_1"
      ]
    },
    "work_id": {
      "$ref": "#/$defs/Id"
    },
    "work_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expected_entity_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source_selection_sha256": {
      "$ref": "#/$defs/Hash"
    },
    "source_pins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/Source"
      }
    },
    "destination_grant_id": {
      "$ref": "#/$defs/Id"
    },
    "destination_bundle_id": {
      "$ref": "#/$defs/Id"
    },
    "destination_manifest_sha256": {
      "$ref": "#/$defs/Hash"
    },
    "destination_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/File"
      }
    },
    "destination_pin_id": {
      "$ref": "#/$defs/Id"
    },
    "obligation_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "recipe_sha256": {
      "$ref": "#/$defs/Hash"
    },
    "durability_receipt_id": {
      "$ref": "#/$defs/Id"
    },
    "database_commit_receipt_id": {
      "$ref": "#/$defs/Id"
    },
    "committed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "transfer_id",
    "idempotency_key",
    "kind",
    "camera",
    "work_id",
    "work_generation",
    "expected_entity_revision",
    "source_selection_sha256",
    "source_pins",
    "sources",
    "destination_grant_id",
    "destination_bundle_id",
    "destination_manifest_sha256",
    "destination_files",
    "destination_pin_id",
    "obligation_ids",
    "recipe_sha256",
    "durability_receipt_id",
    "database_commit_receipt_id",
    "committed_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "hourly_original"
          }
        }
      },
      "then": {
        "properties": {
          "sources": {
            "maxItems": 1
          },
          "destination_files": {
            "maxItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,88}$"
        },
        "chunk_id": {
          "$ref": "#/$defs/Id"
        },
        "chunk_binding_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "member_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "member_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "attempt_id",
        "chunk_id",
        "chunk_binding_sha256",
        "member_sha256",
        "member_bytes"
      ]
    },
    "File": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "$ref": "#/$defs/Id"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "$ref": "#/$defs/Hash"
        }
      },
      "required": [
        "file_id",
        "bytes",
        "sha256"
      ]
    }
  }
}
