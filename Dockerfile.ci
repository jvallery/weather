# SPDX-License-Identifier: MIT
# Tooling image only: the exact same PostgreSQL/pgvector bytes as weather-pg.
FROM registry.vallery.net/jvallery/weather-node-base@sha256:1304d2735b6d11efe11501456ef9e312b1f3141341feec72d61f194c2ab7fd1c AS node

FROM registry.vallery.net/jvallery/mirror-ghcr-io-cloudnative-pg-postgresql-777ad6774e00fff6@sha256:d66df406385b9f3c43c47e94fe3a0002278ef56d21b82a8c9d3a22f91aa9c3f0
USER 0
RUN printf '%s\n' \
 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261023T000000Z trixie main' \
 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261023T000000Z trixie-updates main' \
 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20261023T000000Z trixie-security main' > /etc/apt/sources.list \
 && rm -f /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip passwd \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 1001 weatherci \
 && useradd --uid 1001 --gid 1001 --create-home --shell /bin/bash weatherci
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && npm install --global pnpm@12.15.0 --ignore-scripts --no-audit --no-fund
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
COPY ci/browser/package.json ci/browser/pnpm-lock.yaml ci/browser/.npmrc /opt/weather-browser-tools/
RUN cd /opt/weather-browser-tools \
 && pnpm install --frozen-lockfile --ignore-scripts \
 && pnpm exec playwright install --with-deps chromium webkit firefox \
 && chmod -R a+rX /opt/weather-browser-tools /opt/ms-playwright \
 && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location https://files.pythonhosted.org/packages/3a/ad/3c2a81d66d1839063662e5b6c0002ec31f8ee987dbc5295747627ca6160a/uv-0.13.5-py3-none-manylinux_2_17_x86_64.manylinux2014_x86_64.whl -o /tmp/uv.whl \
 && echo 'fa8d26e08e34c29c0c4e820cf3181757086d547240b4f4d31ff1d8bd810ca946  /tmp/uv.whl' | sha256sum -c - \
 && unzip -q /tmp/uv.whl -d /tmp/uv-wheel \
 && find /tmp/uv-wheel -path '*/scripts/uv' -exec install -m 0755 {} /usr/local/bin/uv \; \
 && mkdir -p /usr/share/doc/weather-ci/uv \
 && find /tmp/uv-wheel -type f \( -iname 'LICENSE*' -o -iname 'NOTICE*' \) -exec cp {} /usr/share/doc/weather-ci/uv/ \; \
 && rm -rf /tmp/uv.whl /tmp/uv-wheel
ENV UV_PYTHON_INSTALL_DIR=/opt/weather-python
RUN uv python install 3.14.9 \
 && ln -s /opt/weather-python/cpython-3.14.9-linux-x86_64-gnu/bin/python3.14 /usr/local/bin/python3
ENV PATH=/usr/lib/postgresql/16/bin:$PATH \
    UV_PYTHON=/usr/local/bin/python3 UV_PYTHON_DOWNLOADS=never
USER 1001:1001
ENTRYPOINT []
CMD ["/bin/bash"]
