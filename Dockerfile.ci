# SPDX-License-Identifier: MIT
# Tooling image only: the exact same PostgreSQL/pgvector bytes as weather-pg.
FROM registry.vallery.net/jvallery/mirror-ghcr-io-cloudnative-pg-postgresql-777ad6774e00fff6@sha256:d66df406385b9f3c43c47e94fe3a0002278ef56d21b82a8c9d3a22f91aa9c3f0
USER 0
RUN printf 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261023T000000Z trixie main\n' > /etc/apt/sources.list \
 && rm -f /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip passwd \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 1001 weatherci \
 && useradd --uid 1001 --gid 1001 --create-home --shell /bin/bash weatherci
RUN curl --fail --location https://files.pythonhosted.org/packages/3a/ad/3c2a81d66d1839063662e5b6c0002ec31f8ee987dbc5295747627ca6160a/uv-0.13.5-py3-none-manylinux_2_17_x86_64.manylinux2014_x86_64.whl -o /tmp/uv.whl \
 && echo 'fa8d26e08e34c29c0c4e820cf3181757086d547240b4f4d31ff1d8bd810ca946  /tmp/uv.whl' | sha256sum -c - \
 && unzip -q /tmp/uv.whl -d /tmp/uv-wheel \
 && find /tmp/uv-wheel -path '*/scripts/uv' -exec install -m 0755 {} /usr/local/bin/uv \; \
 && rm -rf /tmp/uv.whl /tmp/uv-wheel
ENV UV_PYTHON_INSTALL_DIR=/opt/weather-python
RUN uv python install 3.14.9 \
 && ln -s /opt/weather-python/cpython-3.14.9-linux-x86_64-gnu/bin/python3.14 /usr/local/bin/python3
ENV PATH=/usr/lib/postgresql/16/bin:$PATH \
    UV_PYTHON=/usr/local/bin/python3 UV_PYTHON_DOWNLOADS=never
USER 1001:1001
CMD ["/bin/bash"]
